{
  "name": "organic-reaction-navigator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first organic chemistry knowledge system for JEE preparation. Chemistry data is canonical; graphs are derived views.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:study",
    "build:study": "npm run typecheck && node scripts/edition.mjs study build",
    "build:studio": "npm run typecheck && node scripts/edition.mjs studio build",
    "preview": "node scripts/edition.mjs study preview",
    "preview:studio": "node scripts/edition.mjs studio preview",
    "deploy:study": "wrangler deploy",
    "deploy:studio": "wrangler deploy -c wrangler.studio.jsonc",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:property": "vitest run tests/property",
    "test:adversarial": "vitest run tests/adversarial",
    "test:timing": "vitest run --config vitest.timing.config.ts",
    "build:smoke": "npm run build:study && node scripts/check-build.mjs dist && node scripts/check-edition.mjs study dist && npm run build:studio && node scripts/check-build.mjs dist-studio && node scripts/check-edition.mjs studio dist-studio",
    "build:demo": "node scripts/build-demo.mjs",
    "test:coverage": "vitest run --testTimeout=120000 --coverage --coverage.include=src/core/**/*.ts --coverage.include=src/persistence/**/*.ts --coverage.include=src/io/**/*.ts --coverage.include=src/workers/**/*.ts --coverage.include=src/chem/**/*.ts --coverage.include=src/layout/**/*.ts --coverage.include=src/search/**/*.ts --coverage.include=src/app/services/**/*.ts --coverage.include=src/render/scene/**/*.ts --coverage.include=src/render/svg/**/*.{ts,tsx} --coverage.include=src/render/viewport/**/*.{ts,tsx} --coverage.exclude=**/*.test.ts --coverage.exclude=**/contracts.ts --coverage.exclude=**/index.ts --coverage.reporter=text-summary",
    "bench": "node scripts/run-bench-cli.mjs",
    "bench:baseline": "node scripts/generate-baseline.mjs",
    "bench:compare": "node scripts/bench-compare.mjs",
    "e2e": "playwright test",
    "lint": "eslint .",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "check:size": "node scripts/check-file-size.mjs",
    "check:hardcode": "node scripts/check-hardcode.mjs",
    "check:colours": "node scripts/check-colours.mjs",
    "check:control-chars": "node scripts/check-control-chars.mjs",
    "check:bench-budgets": "node scripts/check-bench-budgets.mjs",
    "check": "npm run typecheck && npm run lint && npm run lint:deps && npm run check:size && npm run check:hardcode && npm run check:colours && npm run check:control-chars && npm run check:bench-budgets && npm run test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-tooltip": "1.3.0",
    "@rdkit/rdkit": "2026.3.6",
    "@tanstack/react-virtual": "3.14.13",
    "cmdk": "1.1.1",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "dexie": "^4.4.6",
    "elkjs": "0.12.0",
    "fflate": "^0.8.3",
    "immer": "^10.1.1",
    "minisearch": "7.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.30.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/d3-selection": "3.0.12",
    "@types/d3-zoom": "3.0.9",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^17.0.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^3.23.2",
    "globals": "^16.0.0",
    "jsdom": "30.1.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "wrangler": "4.151.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
