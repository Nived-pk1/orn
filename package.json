{
  "name": "organic-reaction-navigator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first organic chemistry knowledge system for JEE preparation. Chemistry data is canonical; graphs are derived views.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:property": "vitest run tests/property",
    "test:adversarial": "vitest run tests/adversarial",
    "build:demo": "node scripts/build-demo.mjs",
    "test:coverage": "vitest run --testTimeout=120000 --coverage --coverage.include=src/core/**/*.ts --coverage.exclude=**/*.test.ts --coverage.exclude=**/contracts.ts --coverage.exclude=**/index.ts --coverage.reporter=text-summary",
    "bench": "vitest bench --run",
    "e2e": "playwright test",
    "lint": "eslint .",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "check:size": "node scripts/check-file-size.mjs",
    "check:hardcode": "node scripts/check-hardcode.mjs",
    "check": "npm run typecheck && npm run lint && npm run lint:deps && npm run check:size && npm run check:hardcode && npm run test"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^17.0.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-check": "^3.23.2",
    "globals": "^16.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
